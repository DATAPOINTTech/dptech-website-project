data/leads.json
data/conversations/
data/estimates.json
data/invoices.json
data/meetings.json
data/settings.json
data/baileys_auth/
*.log

# Environment & Credentials
.env
.env.*
!.env.example
*.ini
!gemini.ini.example
*.pem
*.key
*.crt

# cPanel & Server Backups
*.tar.gz
*.zip
*.bak
*.backup
error_log

# Node & Build artifacts (legacy / dev)
/node_modules
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
