# Database & Hosted Data Stores (DO NOT OVERWRITE HOSTED DATABASE)
*.sql
*.sqlite
*.sqlite3
*.db
*.rdb
*.dump
*.sql.gz
*.sql.zip
database/
db/
data/*
!data/.htaccess
!data/.gitkeep

